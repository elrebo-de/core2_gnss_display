# This file was generated using idf.py save-defconfig or menuconfig [D] key. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.5 Project Minimal Configuration
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="/Users/christophoberle/.espressif/v5.5.5/esp-idf/components/partition_table/partitions_16MB.csv"
CONFIG_PARTITION_TABLE_FILENAME="/Users/christophoberle/.espressif/v5.5.5/esp-idf/components/partition_table/partitions_16MB.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Enable External SPI RAM
CONFIG_ESP32_SPIRAM_SUPPORT=y

# Set PSRAM Clock Speed to 40MHz for 3.3V stability
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_SPEED="40M"

# Memory Allocation Settings
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SIZE=-1

# PSRAM Bug Workarounds (Mandatory for ESP32 Rev 1/3)
CONFIG_SPIRAM_CACHE_WORKAROUND=y
CONFIG_ESP32_TRACEMEM_RESERVE_DATA=0

CONFIG_ESP_MAIN_TASK_STACK_SIZE=65536
CONFIG_ESP_TIMER_TASK_STACK_SIZE=16384

CONFIG_FREERTOS_CHECK_STACKOVERFLOW_PTRVAL=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_BSP_PMU_AXP2101=y
CONFIG_FATFS_LFN_HEAP=y

CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_LOG_MAXIMUM_LEVEL=4
